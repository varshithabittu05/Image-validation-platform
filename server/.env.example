# Copy to .env and fill in DATABASE_URL from your Neon dashboard.
# File storage is local disk (./storage), served by the API server itself
# under /files -- see storageService.ts for why (every external S3-compatible
# option hit corporate-network friction; swapping to real S3/R2 later is a
# small, isolated change to that one file).

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Neon connection string (Project dashboard -> Connection string)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Upload constraints
MAX_UPLOAD_BYTES=125829120

# Validation thresholds
MIN_FILE_SIZE_BYTES=10240
MIN_WIDTH_PX=400
MIN_HEIGHT_PX=400
BLUR_VARIANCE_THRESHOLD=60
DUPLICATE_HAMMING_DISTANCE_THRESHOLD=8
MIN_FACE_AREA_RATIO=0.03

FACE_MODEL_PATH=./models
